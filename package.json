{
  "name": "chatrooms",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time group chat backend — WebSockets + Redis Pub/Sub + MongoDB",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/scripts/seed.ts",
    "peek": "docker exec chatrooms-mongo mongosh chatrooms --quiet --eval 'db.messages.find().sort({serverTimestamp:-1}).forEach(d => print(d.serverTimestamp.toISOString() + \"  \" + d.senderId + \"  \" + d.body))'"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.6.0",
    "redis": "^6.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.5.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
